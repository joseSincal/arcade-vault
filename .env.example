# Copia este archivo a .env.local y completa los valores.
# .env.local no se versiona. Nunca pongas claves reales en este archivo.
# Estas variables solo se leen en el servidor (sin prefijo NEXT_PUBLIC_).

# API key de Resend (https://resend.com/api-keys). Obligatoria.
RESEND_API_KEY=

# Correo que recibe los mensajes del formulario de contacto. Obligatoria.
# Con el remitente por defecto (onboarding@resend.dev), Resend solo entrega
# al correo de la cuenta de Resend: en desarrollo usa ese mismo correo.
CONTACT_TO_EMAIL=

# Remitente de los correos. Opcional: si no se define, se usa onboarding@resend.dev.
# Para producción, usa una dirección de un dominio verificado en Resend.
CONTACT_FROM_EMAIL=
